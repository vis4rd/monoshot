[submodule "GLFW"]
	path = lib/glfw
	url = https://github.com/glfw/glfw.git
[submodule "GLM"]
	path = lib/glm
	url = https://github.com/g-truc/glm.git
[submodule "IMGUI"]
	path = lib/imgui/imgui
	url = https://github.com/ocornut/imgui.git
	branch = docking
[submodule "SPDLOG"]
	path = lib/spdlog
	url = https://github.com/gabime/spdlog.git
[submodule "ENTT"]
	path = lib/entt
	url = https://github.com/skypjack/entt.git
[submodule "TINYFILEDIALOGS"]
	path = lib/tinyfiledialogs/tinyfiledialogs
	url = https://git.code.sf.net/p/tinyfiledialogs/code
[submodule "INIFILE-CPP"]
	path = lib/inifile-cpp/inifile-cpp
	url = https://github.com/Rookfighter/inifile-cpp.git
[submodule "GLBINDING"]
	path = lib/glbinding
	url = https://github.com/cginternals/glbinding.git
