{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run clang-format",
            "detail": "Run clang-format on all C++ files in src/ directory.",
            "type": "shell",
            "command": "cmake -P ./cmake/clang-format.cmake",
            "icon": {
                "color": "terminal.ansiCyan",
                "id": "edit"
            },
            "presentation": {
                "clear": true,
                "panel": "dedicated",
                "reveal": "silent",
                "showReuseMessage": false
            }
        },
        {
            "label": "Run clang-tidy (all files)",
            "detail": "Run clang-tidy on all C++ files in src/ directory.",
            "type": "shell",
            "command": "cmake -P ./cmake/clang-tidy.cmake \"src/engine/module\"",
            "icon": {
                "color": "terminal.ansiCyan",
                "id": "sparkle"
            },
            "problemMatcher": {
                "source": "clang-tidy",
                "owner": "clang-tidy",
                "applyTo": "allDocuments",
                "fileLocation": "absolute",
                "pattern": [
                    {
                        "regexp": "^(.*):([0-9]{1,6}):([0-9]{1,6}):\\s([a-z]+):\\s(.*)\\[(.*)\\]$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5,
                        "code": 6
                    }
                ]
            },
            "presentation": {
                "clear": true,
                "panel": "dedicated",
                "reveal": "silent",
                "showReuseMessage": false
            }
        },
        {
            "label": "Run clang-tidy (current file)",
            "detail": "Run clang-tidy on the currently active open file.",
            "type": "shell",
            "command": "clang-tidy --quiet --config-file=.clang-tidy -p=build/ ${file}",
            "icon": {
                "color": "terminal.ansiWhite",
                "id": "sparkle"
            },
            "problemMatcher": {
                "source": "clang-tidy",
                "owner": "clang-tidy",
                "applyTo": "openDocuments",
                "fileLocation": "absolute",
                "pattern": [
                    {
                        "regexp": "^(.*):([0-9]{1,6}):([0-9]{1,6}):\\s([a-z]+):\\s(.*)\\[(.*)\\]$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5,
                        "code": 6
                    }
                ]
            },
            "presentation": {
                "clear": true,
                "echo": true,
                "panel": "dedicated",
                "reveal": "silent",
                "showReuseMessage": false
            }
        },
        {
            "label": "Setup hooks",
            "detail": "Copy git hooks to .git/hooks/ directory.",
            "type": "shell",
            "linux": {
                "command": "cp -r .githooks/* .git/hooks/"
            },
            "windows": {
                "command": "Copy-Item -Path '.githooks/*' -Destination '.git/hooks/' -Exclude '.*'"
            },
            "icon": {
                "color": "terminal.ansiYellow",
                "id": "git-branch"
            },
            "presentation": {
                "clear": true,
                "reveal": "silent",
                "showReuseMessage": false
            },
            "hide": true,
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Disable commit hooks",
            "detail": "Rename all hook files in .git/hooks to disable them.",
            "type": "shell",
            "linux": {
                "command": "for f in .git/hooks/*; do if [[ ! \"$f\" =~ \\.[^/]*$ ]]; then mv \"$f\" \"$f.disabled\"; fi; done"
            },
            "windows": {
                "command": "Get-ChildItem -Path '.git/hooks/*' -Exclude *.sample, *.disabled | Where-Object { -Not $_.Extension } | Rename-Item -NewName { $_.Name + '.disabled' }"
            },
            "icon": {
                "color": "terminal.ansiRed",
                "id": "git-branch"
            },
            "presentation": {
                "clear": true,
                "panel": "dedicated",
                "reveal": "silent",
                "showReuseMessage": false
            }
        },
        {
            "label": "Enable commit hooks",
            "detail": "Rename all .disabled files in .git/hooks back to enable them.",
            "type": "shell",
            "linux": {
                "command": "for f in .git/hooks/*.disabled; do mv \"$f\" \"${f%.disabled}\"; done"
            },
            "windows": {
                "command": "Get-ChildItem -Path '.git/hooks/*.disabled' | Rename-Item -NewName { $_.Name -replace '.disabled$', '' }"
            },
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "git-branch"
            },
            "presentation": {
                "clear": true,
                "panel": "dedicated",
                "reveal": "silent",
                "showReuseMessage": false
            }
        }
    ]
}
