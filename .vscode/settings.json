{
    "C_Cpp.autoAddFileAssociations": false,
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.clangTidy.useBuildPath": true,
    "C_Cpp.codeAnalysis.exclude": {
        "**/engine/lib/**": true,
        "**/build/**": true,
    },
    "C_Cpp.debugShortcut": false,
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.doxygen.sectionTags": [
        "attention",
        "deprecated",
        "exception",
        "link",
        "note",
        "param",
        "pre",
        "ref",
        "result",
        "returns",
        "retval",
        "tparam",
        "unlink",
        "warning",
    ],
    "C_Cpp.intelliSenseCachePath": "${workspaceFolder}/.cache/vscode-cpptools",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.loggingLevel": "Information",
    "C_Cpp.markdownInComments": "enabled",
    "C_Cpp.preferredPathSeparator": "Forward Slash",
    "C_Cpp.refactoring.includeHeader": "never",
    //
    "cmake.buildBeforeRun": false,
    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false,
    "cmake.languageSupport.enableFileAPI": true,
    //
    "doxdocgen.generic.briefTemplate": "@brief {text}.",
    "doxdocgen.generic.order": [
        "brief",
        "tparam",
        "param",
        "return",
        "custom"
    ],
    "doxdocgen.generic.paramTemplate": "@param {param} ",
    //
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.renderLineHighlight": "gutter",
    //
    "files.eol": "\n",
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": true,
    "files.associations": {
        "*.inl": "cpp",
    },
    //
    "git.detectSubmodules": false,
    "git.ignoreSubmodules": true,
    "git.suggestSmartCommit": false,
    //
    "gitmoji.outputType": "code",
    "gitmoji.showEmojiCode": true,
    //
    "search.exclude": {
        "**/engine/lib/**": true,
    },
    //
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
    },
    "[cmake]": {
        "files.insertFinalNewline": true,
    },
    "[ini]": {
        "files.insertFinalNewline": true,
    },
    "[jsonc]": {
        "files.insertFinalNewline": true,
    },
    "[markdown]": {
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
    },
    "[yaml]": {
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
    }
}
